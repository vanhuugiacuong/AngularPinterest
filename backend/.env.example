# Server configuration
PORT=3000

# Database Connection (Supabase PostgreSQL Connection String)
# Replace [PASSWORD], [HOST], and [DB_NAME] with your Supabase DB credentials
# Port 6543 = Supavisor transaction mode. Do NOT use 5432 (session mode): there
# each client holds a Postgres backend for its whole lifetime, so a pool of N
# permanently occupies N of the project's 15 client connections.
# ?pgbouncer=true is harmless but does nothing for us — it configures Prisma's
# own engine pooling, and this backend uses the pg driver adapter instead.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Size of THIS process's pg pool. Supavisor caps the whole project at 15 client
# connections, shared by every backend, every teammate running one, every
# scratch/*.cjs run and Prisma Studio. Keep it small on a dev machine (default
# 3); raise it only on a production instance that has the budget to itself.
PG_POOL_MAX=3

# Supabase Project Configuration
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# Supabase Auth Configuration (Used to verify JWT tokens from client)
# You can find this in your Supabase Dashboard -> Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-here"

# CLIP Embedding Service Configuration (Dockerized Fast-API microservice)
CLIP_SERVICE_URL="http://localhost:8001"

# Pexels API (free stock photos, used by scratch/fetch_pexels_pins.ts to seed more pins)
# Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY="your-pexels-api-key-here"

# ── Thương mại hoá: thanh toán QR (VietQR) + webhook đối soát (SePay) ──────────
# Tài khoản nhận tiền để sinh mã VietQR (bin theo chuẩn Napas; MB Bank = 970422)
BANK_BIN="970422"
BANK_ACCOUNT_NO="0000000000"
BANK_ACCOUNT_NAME="PINHUB DEMO"
BANK_SHORT_NAME="MB Bank"

# SePay: dịch vụ đối soát chuyển khoản, bắn webhook khi có tiền vào.
# Đăng ký tại https://sepay.vn -> thêm tài khoản ngân hàng -> tạo Webhook trỏ tới
#   POST {BACKEND_URL}/api/billing/webhook/sepay
# rồi đặt "API Key" ở SePay trùng với giá trị dưới (webhook gửi header
#   Authorization: Apikey <SEPAY_API_KEY>). Để trống nếu muốn tắt kiểm tra (chỉ dev).
SEPAY_API_KEY="your-sepay-webhook-api-key"

# API token để backend tự poll giao dịch SePay (tự động, không cần webhook công khai).
# SePay -> Công ty -> API Access -> API Token.
SEPAY_API_TOKEN="your-sepay-api-token"

# Unsplash Access Key — dùng để seed ảnh nền aesthetic vào feed khi chưa có nhiều
# user đăng ảnh. Lấy tại https://unsplash.com/developers (New Application).
# Chỉ dùng cho script scratch/seed-unsplash.cjs, không cần khi chạy app thường.
UNSPLASH_ACCESS_KEY="your-unsplash-access-key"

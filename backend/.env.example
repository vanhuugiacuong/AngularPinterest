# Server configuration
PORT=3001

# Database Connection (Supabase PostgreSQL Connection String)
# Replace [PASSWORD], [HOST], and [DB_NAME] with your Supabase DB credentials
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Project Configuration
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# Supabase Auth Configuration (Used to verify JWT tokens from client)
# You can find this in your Supabase Dashboard -> Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-here"

# CLIP Embedding Service Configuration (Dockerized Fast-API microservice)
# Also powers NSFW image moderation (POST /moderate/image) used by the
# create-post flow — no separate API key needed, see clip-service's
# NSFW_THRESHOLD below.
CLIP_SERVICE_URL="http://localhost:8001"

# Reverse image search ("Tìm kiếm hình ảnh") relevance thresholds.
# IMAGE_SEARCH_MIN_SIMILARITY: minimum cosine similarity (0-1) a result must
# clear to be returned at all — below this it's considered unrelated, not a
# weak match. IMAGE_SEARCH_MAX_SIMILARITY_GAP: max drop in similarity vs the
# single best result in the batch before a candidate is dropped. Tune both
# against real pin embeddings — CLIP's baseline cosine similarity between
# unrelated images is model-dependent, so these are NOT universal constants.
IMAGE_SEARCH_MIN_SIMILARITY=0.45
IMAGE_SEARCH_MAX_SIMILARITY_GAP=0.25

# SePay webhook (xác nhận thanh toán tự động cho nâng cấp gói PLUS/PRO).
# Lấy trong dashboard SePay -> Webhooks -> tạo webhook -> chọn xác thực API Key.
# Thiếu biến này thì endpoint /api/memberships/payments/webhook/sepay sẽ trả về
# 501 và không tự kích hoạt gói nào - phải xác nhận thủ công qua endpoint admin.
SEPAY_WEBHOOK_API_KEY=

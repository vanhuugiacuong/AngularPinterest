# Server configuration
PORT=3000

# Database Connection (Supabase PostgreSQL Connection String)
# Replace [PASSWORD], [HOST], and [DB_NAME] with your Supabase DB credentials
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Project Configuration
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# Supabase Auth Configuration (Used to verify JWT tokens from client)
# You can find this in your Supabase Dashboard -> Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-here"

# CLIP Embedding Service Configuration (Dockerized Fast-API microservice)
CLIP_SERVICE_URL="http://localhost:8001"

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// ⚠️ CẢNH BÁO (nhánh liem-billing-qr): DB Supabase này DÙNG CHUNG với cả nhóm và
// chứa nhiều bảng của hệ thống membership/NovaToken (MembershipSubscription,
// NovaTokenTopUp, ImagePurchase, Auction, WatermarkPreset...) KHÔNG có trong file
// schema này. => TUYỆT ĐỐI KHÔNG chạy `prisma db push` / `prisma migrate` từ nhánh
// này (Prisma sẽ tưởng các bảng đó thừa và XOÁ mất dữ liệu thật của nhóm).
// Các bảng/cột của tính năng billing-QR riêng được thêm bằng SQL chỉ-thêm:
//   backend/scratch/apply-billing.sql  (idempotent, CREATE ... IF NOT EXISTS)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Bảng User đồng bộ với id từ auth.users của Supabase
model User {
  id           String    @id // Trùng với ID UUID do Supabase Auth cấp
  username     String    @unique
  email        String    @unique
  avatarUrl    String?
  bio          String?
  showAllPins  Boolean   @default(true)
  createdAt    DateTime  @default(now())

  // Thương mại hoá (Pro + Credit)
  isPro        Boolean   @default(false)
  proExpiresAt DateTime?
  /// Cấp gói Pro hiện tại ("MONTHLY" | "YEARLY") — lưu thẳng ở đây để mọi nơi
  /// hiển thị avatar biết cấp gói mà không phải join Subscription. Tên có tiền
  /// tố pinhub vì bảng User dùng chung với hệ thống khác (đã có cột `plan`).
  /// Cột tạo bằng SQL thủ công: scratch/apply-pro-plan.cjs.
  pinhubProPlan String?

  wallet        Wallet?
  subscriptions Subscription[]
  payments      Payment[]
  creditTxns    CreditTransaction[]
  entitlements  PinEntitlement[]

  pins         Pin[]
  boards       Board[]
  boardCollaborations BoardCollaborator[]
  likes        Like[]
  comments     Comment[]

  followers    Follow[]  @relation("UserFollowers")
  following    Follow[]  @relation("UserFollowing")

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationSender")

  sentMessageRequests     MessageRequest[] @relation("MessageRequestSender")
  receivedMessageRequests MessageRequest[] @relation("MessageRequestReceiver")

  conversationsAsUserOne Conversation[]    @relation("ConversationsAsUserOne")
  conversationsAsUserTwo Conversation[]    @relation("ConversationsAsUserTwo")
  sentMessages           Message[]         @relation("MessageSender")
  messageReactions       MessageReaction[]

  hiddenPins       HiddenPin[]
  pinReports       PinReport[]
  interestSignals  InterestSignal[]
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model Pin {
  id              String      @id @default(uuid())
  title           String
  description     String?
  imageUrl        String      // CDN URL từ Supabase Storage Bucket ("pins")
  sourceUrl       String?
  userId          String
  createdAt       DateTime    @default(now())

  isAiGenerated   Boolean     @default(false)
  promptUsed      String?
  negativePrompt  String?
  generationModel String?
  isCollage       Boolean     @default(false) // published from the Ảnh ghép (collage) editor
  category        String      @default("other")
  embedding       Unsupported("vector(512)")? // pgvector similarity embedding, managed outside Prisma
  // NOTE: a "visualCategory" TEXT column also exists on this table, managed outside Prisma
  // (added + backfilled by scratch/classify_visual_categories.ts). It stores the CLIP-classified
  // visual category of the pin's image (dog/cat/animal/person/food/scenery/anime/product) and is
  // used to scope "search by image" results. See src/pins/visual-search.ts.
  // NOTE: an "avgColor" vector(3) column also exists, managed outside Prisma (added + backfilled by
  // scratch/backfill_avg_colors.ts). It stores the mean RGB (0-255) of the pin image, used to rank
  // flat-colour crop searches by colour proximity.

  // Ảnh Premium (bán — trả credit để tải HD). imageUrl/previewUrl = bản watermark
  // công khai; originalPath = key file HD trong bucket PRIVATE (không public URL).
  isPremium       Boolean     @default(false)
  priceCredits    Int?
  previewUrl      String?
  originalPath    String?
  isArchived      Boolean     @default(false)

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardPins       BoardPin[]
  likes           Like[]
  comments        Comment[]
  notifications   Notification[]
  sharedInMessages Message[]
  hiddenBy        HiddenPin[]
  reports         PinReport[]
  interestSignals InterestSignal[]
  entitlements    PinEntitlement[]
}

// A user hid this pin from their own feed ("Ẩn bớt") — excluded from
// getAllPins() for that user going forward.
model HiddenPin {
  userId    String
  pinId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pin  Pin  @relation(fields: [pinId], references: [id], onDelete: Cascade)

  @@id([userId, pinId])
}

// A user reported this pin ("Báo cáo Ghim") — no moderation queue UI yet,
// just persisted so reports aren't lost and can be reviewed later.
/// Người dùng báo sự cố chuyển khoản để admin xử lý (đã chuyển nhưng chưa
/// nhận, sai số tiền, sai nội dung...). Bảng tạo bằng SQL thủ công —
/// xem scratch/apply-payment-report.cjs. KHÔNG chạy prisma db push.
model PaymentReport {
  id         String    @id @default(uuid())
  userId     String
  paymentId  String?
  memo       String?
  reason     String
  note       String?
  status     String    @default("OPEN")
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status])
  @@index([userId])
}

model PinReport {
  id        String   @id @default(uuid())
  userId    String
  pinId     String
  reason    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pin  Pin  @relation(fields: [pinId], references: [id], onDelete: Cascade)

  @@index([pinId])
}

// A user asked for "Xem thêm" (more like this) on a pin — folded into
// getAllPins()'s preferredCategories scoring alongside likes/board saves.
model InterestSignal {
  userId    String
  pinId     String
  category  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pin  Pin  @relation(fields: [pinId], references: [id], onDelete: Cascade)

  @@id([userId, pinId])
}

model Board {
  id          String      @id @default(uuid())
  name        String
  description String?
  isSecret    Boolean     @default(false)
  userId      String
  createdAt   DateTime    @default(now())

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardPins       BoardPin[]
  collaborators   BoardCollaborator[]
}

// A user (not the owner) invited to co-manage a board — can add/remove Pins on it,
// same as the owner, but cannot rename/delete the board or manage other collaborators.
model BoardCollaborator {
  boardId String
  userId  String
  addedAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
}

model BoardPin {
  boardId   String
  pinId     String
  addedAt   DateTime @default(now())
  sortOrder Int?     // manual drag-reorder position from the "Chọn và sắp xếp lại" screen; null = not yet manually placed, falls back to addedAt desc
  isFavorite Boolean @default(false) // starred within this board, for the "Yêu thích" filter

  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  pin       Pin      @relation(fields: [pinId], references: [id], onDelete: Cascade)

  @@id([boardId, pinId])
}

model Like {
  userId    String
  pinId     String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pin       Pin      @relation(fields: [pinId], references: [id], onDelete: Cascade)

  @@id([userId, pinId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  userId    String
  pinId     String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pin       Pin      @relation(fields: [pinId], references: [id], onDelete: Cascade)
}

// type: "like" | "comment" | "follow" | "save" | "new_pin"
model Notification {
  id        String   @id @default(uuid())
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId    String
  senderId  String?
  pinId     String?
  content   String

  user      User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  sender    User?    @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  pin       Pin?     @relation(fields: [pinId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

enum MessageRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  REPORTED
}

model MessageRequest {
  id          String               @id @default(uuid())
  senderId    String
  receiverId  String
  status      MessageRequestStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  respondedAt DateTime?

  sender      User @relation("MessageRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User @relation("MessageRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
}

// 1-1 conversation between two users. participantKey normalizes the pair
// (sorted user ids joined together) so the unique constraint prevents
// creating a duplicate conversation for the same pair.
model Conversation {
  id             String    @id @default(uuid())
  participantKey String    @unique
  userOneId      String
  userTwoId      String
  createdAt      DateTime  @default(now())
  lastMessageAt  DateTime?

  userOne  User      @relation("ConversationsAsUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo  User      @relation("ConversationsAsUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userOneId])
  @@index([userTwoId])
}

enum MessageContentType {
  TEXT
  IMAGE
  GIF
  PIN
}

model Message {
  id             String             @id @default(uuid())
  conversationId String
  senderId       String
  type           MessageContentType @default(TEXT)
  content        String?            @db.VarChar(4000)
  imageUrl       String?
  gifUrl         String?
  pinId          String?
  replyToId      String?
  createdAt      DateTime           @default(now())
  readAt         DateTime?
  deletedAt      DateTime?
  pinnedAt       DateTime?

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  pin          Pin?              @relation(fields: [pinId], references: [id], onDelete: SetNull)
  replyTo      Message?          @relation("MessageReplyTo", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]         @relation("MessageReplyTo")
  reactions    MessageReaction[]

  @@index([conversationId, createdAt])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Thương mại hoá: Pro subscription + Credit + thanh toán QR (VietQR/SePay/PayOS)
// ─────────────────────────────────────────────────────────────────────────────

// Ví credit của user. spendable = credit dùng để tải ảnh Premium (grant + mua);
// earnings = credit thu nhập từ bán ảnh (tách riêng).
model Wallet {
  userId         String    @id
  spendable      Int       @default(0)
  earnings       Int       @default(0)
  grantExpiresAt DateTime?
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SubPlan {
  MONTHLY
  YEARLY
}

enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id        String    @id @default(uuid())
  userId    String
  plan      SubPlan
  status    SubStatus @default(ACTIVE)
  startedAt DateTime  @default(now())
  expiresAt DateTime
  paymentId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum PaymentPurpose {
  PRO_SUB
  CREDIT_PACK
}

// Đổi tên thành QrPaymentStatus để KHÔNG trùng enum `PaymentStatus` đã có sẵn của
// hệ thống membership cũ trong DB dùng chung.
enum QrPaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

// Một đơn thanh toán qua chuyển khoản QR. `memo` là nội dung CK định danh dùng để
// đối soát tự động khi webhook ngân hàng (SePay/PayOS) báo có tiền vào.
model Payment {
  id             String         @id @default(uuid())
  userId         String
  provider       String         @default("VIETQR")
  purpose        PaymentPurpose
  amountVnd      Int
  planCode       String? // MONTHLY | YEARLY
  packCode       String? // S | M | L | XL
  creditsGranted Int? // số credit sẽ cộng khi PAID
  status         QrPaymentStatus @default(PENDING)
  memo           String         @unique // nội dung CK, vd PINHUBABC123
  gatewayRef     String? // mã giao dịch phía ngân hàng/cổng
  createdAt      DateTime       @default(now())
  expiresAt      DateTime
  paidAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PinEntitlement {
  userId      String
  pinId       String
  creditsPaid Int
  grantedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pin  Pin  @relation(fields: [pinId], references: [id], onDelete: Cascade)

  @@id([userId, pinId])
  @@index([pinId])
}

enum CreditTxnType {
  PURCHASE
  MONTHLY_GRANT
  SPEND_DOWNLOAD
  EARN_SALE
  PLATFORM_FEE
  GRANT_EXPIRE
  REFUND
}

model CreditTransaction {
  id           String        @id @default(uuid())
  userId       String
  type         CreditTxnType
  amount       Int // + cộng, - trừ
  balanceAfter Int
  refPinId     String?
  refPaymentId String?
  note         String?
  createdAt    DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

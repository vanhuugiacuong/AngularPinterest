// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Bảng User đồng bộ với id từ auth.users của Supabase
model User {
  id                  String                   @id // Trùng với ID UUID do Supabase Auth cấp
  username            String                   @unique // ID duy nhất dùng trong URL hồ sơ - khác với displayName
  displayName         String?                  // Tên hiển thị - text tự do, không cần duy nhất. Null = hiển thị username thay thế.
  email               String                   @unique
  avatarUrl           String?
  bio                 String?
  createdAt           DateTime                 @default(now())
  plan                MembershipPlan           @default(FREE)
  ownedPlans          MembershipPlan[]         @default([FREE])
  planStartedAt       DateTime?
  planExpiresAt       DateTime?
  isAdmin             Boolean                  @default(false)
  isPrivate           Boolean                  @default(false)
  // Tài khoản nhận tiền của người bán — bắt buộc phải điền trước khi được
  // bán ảnh/tạo đấu giá. Mã ngân hàng luôn được backend kiểm tra theo
  // whitelist SUPPORTED_BANKS, không nhận string tuỳ ý từ client.
  payoutBankCode      String?
  payoutAccountNumber String?
  payoutAccountName   String?
  aiUsages            AiUsage[]
  purchases           ImagePurchase[]          @relation("BuyerPurchases")
  sales               ImagePurchase[]          @relation("SellerSales")
  payments            MembershipPayment[]
  subscriptions       MembershipSubscription[]
  watermarkPresets    WatermarkPreset[]

  pins     Pin[]
  boards   Board[]
  likes    Like[]
  comments Comment[]

  followers               Follow[]         @relation("UserFollowers")
  following               Follow[]         @relation("UserFollowing")
  followRequestsSent      FollowRequest[]  @relation("FollowRequestsSent")
  followRequestsReceived  FollowRequest[]  @relation("FollowRequestsReceived")
  messageRequestsSent     MessageRequest[] @relation("MessageRequestsSent")
  messageRequestsReceived MessageRequest[] @relation("MessageRequestsReceived")
  conversationsAsUserOne  Conversation[]   @relation("ConversationsAsUserOne")
  conversationsAsUserTwo  Conversation[]   @relation("ConversationsAsUserTwo")
  messages                Message[]
  blocksMade              UserBlock[]      @relation("UserBlocksMade")
  blocksReceived          UserBlock[]      @relation("UserBlocksReceived")
  reportsMade             UserReport[]     @relation("UserReportsMade")
  reportsReceived         UserReport[]     @relation("UserReportsReceived")

  notifications     Notification[] @relation("UserNotifications")
  sentNotifications Notification[] @relation("UserSentNotifications")

  auctionsSelling Auction[]    @relation("AuctionsSelling")
  auctionsWon     Auction[]    @relation("AuctionsWon")
  auctionBids     AuctionBid[]
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

model Follow {
  followerId  String
  followingId String
  status      FollowStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  respondedAt DateTime?

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@index([followingId, status])
}

model Pin {
  id                  String          @id @default(uuid())
  title               String
  description         String?
  imageUrl            String // URL preview công khai (bucket "pins", có thể đã qua watermark)
  originalStoragePath String? // Path bản gốc trong bucket private "pins-original" - chỉ backend đọc được
  sourceUrl           String?
  userId              String
  createdAt           DateTime        @default(now())
  price               Decimal?        @db.Decimal(12, 2)
  currency            Currency        @default(VND)
  isForSale           Boolean         @default(false)
  purchases           ImagePurchase[]
  auctions            Auction[]

  isAiGenerated   Boolean                     @default(false)
  promptUsed      String?
  negativePrompt  String?
  generationModel String?
  category        String                      @default("other")
  embedding       Unsupported("vector(512)")?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardPins     BoardPin[]
  likes         Like[]
  comments      Comment[]
  notifications Notification[]
}

enum MembershipPlan {
  FREE
  PLUS
  PRO
}

model AiUsage {
  id        String   @id @default(uuid())
  userId    String
  usageDate DateTime @db.Date
  count     Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, usageDate])
}

model ImagePurchase {
  id                    String    @id @default(uuid())
  pinId                 String
  buyerId               String
  sellerId              String
  amount                Decimal   @db.Decimal(12, 2)
  currency              Currency  @default(VND)
  status                String    @default("PENDING") // PENDING | PAID | FAILED
  paymentReference      String?   @unique // mã đối chiếu nội dung chuyển khoản, khớp qua webhook SePay
  providerTransactionId String?   @unique
  verifiedAt            DateTime?
  createdAt             DateTime  @default(now())
  auctionId             String?   @unique // gắn với phiên đấu giá nếu đây là giao dịch thanh toán của người thắng
  pin                   Pin       @relation(fields: [pinId], references: [id], onDelete: Cascade)
  buyer                 User      @relation("BuyerPurchases", fields: [buyerId], references: [id], onDelete: Cascade)
  seller                User      @relation("SellerSales", fields: [sellerId], references: [id], onDelete: Cascade)
  auction               Auction?  @relation(fields: [auctionId], references: [id], onDelete: SetNull)

  @@unique([pinId, buyerId])
}

enum Currency {
  VND
}

enum AuctionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

// Một phiên đấu giá cho một Pin. Tối đa một phiên chưa kết thúc (DRAFT/
// SCHEDULED/ACTIVE) cho mỗi pin - enforce bằng partial unique index thêm
// thủ công trong migration (xem migration.sql), không chỉ ở tầng service.
model Auction {
  id               String        @id @default(uuid())
  pinId            String
  sellerId         String
  currency         Currency      @default(VND)
  startingPrice    Decimal       @db.Decimal(12, 2)
  currentPrice     Decimal       @db.Decimal(12, 2)
  minimumIncrement Decimal       @db.Decimal(12, 2)
  startsAt         DateTime
  endsAt           DateTime
  status           AuctionStatus @default(SCHEDULED)
  winnerId         String?
  bidCount         Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  pin      Pin            @relation(fields: [pinId], references: [id], onDelete: Cascade)
  seller   User           @relation("AuctionsSelling", fields: [sellerId], references: [id], onDelete: Cascade)
  winner   User?          @relation("AuctionsWon", fields: [winnerId], references: [id], onDelete: SetNull)
  bids     AuctionBid[]
  purchase ImagePurchase?

  @@index([sellerId, status])
  @@index([status, endsAt])
  @@index([pinId, status])
}

// requestKey là khóa idempotency do client sinh (uuid) - unique constraint
// chặn tạo bid trùng khi double-click hoặc retry request cùng một lần bấm.
model AuctionBid {
  id         String   @id @default(uuid())
  auctionId  String
  bidderId   String
  amount     Decimal  @db.Decimal(12, 2)
  requestKey String   @unique
  createdAt  DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder  User    @relation(fields: [bidderId], references: [id], onDelete: Cascade)

  @@index([auctionId, createdAt])
}

enum WatermarkType {
  TEXT
  LOGO
}

enum WatermarkPosition {
  TOP_LEFT
  TOP_CENTER
  TOP_RIGHT
  MIDDLE_LEFT
  MIDDLE_CENTER
  MIDDLE_RIGHT
  BOTTOM_LEFT
  BOTTOM_CENTER
  BOTTOM_RIGHT
}

// Cấu hình watermark cá nhân của Plus/Pro. Free không được tạo (chặn ở
// service). Plus tối đa 1 preset (cơ bản), Pro nhiều preset + tính năng
// nâng cao (tiled/rotation/spacing) - enforce theo PLAN_ENTITLEMENTS.
model WatermarkPreset {
  id              String            @id @default(uuid())
  userId          String
  name            String
  type            WatermarkType
  text            String?
  logoStoragePath String?
  position        WatermarkPosition @default(BOTTOM_RIGHT)
  opacity         Float             @default(0.6)
  scale           Float             @default(0.2)
  margin          Float             @default(0.03)
  rotation        Float             @default(0)
  tiled           Boolean           @default(false)
  spacing         Float             @default(0.5)
  isDefault       Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

// Một yêu cầu thanh toán nâng cấp gói. Backend tự tính amount từ PLAN_PRICE_VND,
// không bao giờ nhận amount từ client. Chỉ chuyển PENDING -> PAID khi có webhook
// đã xác thực chữ ký/API key hoặc admin xác nhận thủ công (xem PaymentsService).
model MembershipPayment {
  id                    String         @id @default(uuid())
  userId                String
  plan                  MembershipPlan
  amount                Decimal        @db.Decimal(12, 2)
  paymentReference      String         @unique
  status                PaymentStatus  @default(PENDING)
  provider              String
  providerTransactionId String?        @unique
  rawPayload            Json?
  createdAt             DateTime       @default(now())
  verifiedAt            DateTime?
  verifiedBy            String?

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription MembershipSubscription?

  @@index([userId, status])
}

// Một chu kỳ gói đã kích hoạt thành công, gắn 1-1 với payment đã PAID.
model MembershipSubscription {
  id        String         @id @default(uuid())
  userId    String
  plan      MembershipPlan
  paymentId String         @unique
  startedAt DateTime       @default(now())
  expiresAt DateTime
  createdAt DateTime       @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment MembershipPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

// Nhật ký cho các hành động nhạy cảm: đổi gói, thanh toán, tải ảnh sạch, đổi watermark.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model Board {
  id          String   @id @default(uuid())
  name        String
  description String?
  isSecret    Boolean  @default(false)
  userId      String
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardPins BoardPin[]

  @@index([userId, isSecret, createdAt])
}

model BoardPin {
  boardId String
  pinId   String
  addedAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  pin   Pin   @relation(fields: [pinId], references: [id], onDelete: Cascade)

  @@id([boardId, pinId])
}

model Like {
  userId    String
  pinId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pin  Pin  @relation(fields: [pinId], references: [id], onDelete: Cascade)

  @@id([userId, pinId])
  @@index([userId, createdAt])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  userId    String
  pinId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pin  Pin  @relation(fields: [pinId], references: [id], onDelete: Cascade)
}

enum MessageRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  REPORTED
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  IMPERSONATION
  INAPPROPRIATE_CONTENT
  OTHER
}

// Một lời mời nhắn tin giữa hai người dùng chưa follow lẫn nhau.
// Ràng buộc unique theo đúng chiều gửi để chặn gửi trùng (nghiệp vụ +
// application layer chặn luôn cả chiều ngược lại trước khi tạo).
model MessageRequest {
  id          String               @id @default(uuid())
  senderId    String
  receiverId  String
  status      MessageRequestStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  respondedAt DateTime?

  sender   User        @relation("MessageRequestsSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User        @relation("MessageRequestsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  report   UserReport?

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

enum FollowRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Yêu cầu theo dõi một tài khoản riêng tư (isPrivate = true). Tài khoản công
// khai không tạo bản ghi này — follow có hiệu lực ngay lập tức (xem Follow).
model FollowRequest {
  id          String              @id @default(uuid())
  senderId    String
  receiverId  String
  status      FollowRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?

  sender   User @relation("FollowRequestsSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FollowRequestsReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

// Cuộc trò chuyện 1-1. participantKey chuẩn hóa cặp userId (sắp xếp rồi nối
// lại) để unique constraint ngăn tạo trùng conversation cho cùng một cặp,
// kể cả khi hai yêu cầu tạo chạy gần như đồng thời.
model Conversation {
  id             String    @id @default(uuid())
  participantKey String    @unique
  userOneId      String
  userTwoId      String
  createdAt      DateTime  @default(now())
  lastMessageAt  DateTime?

  userOne  User      @relation("ConversationsAsUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo  User      @relation("ConversationsAsUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userOneId])
  @@index([userTwoId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String    @db.VarChar(4000)
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("UserBlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// Report độc lập từ trang profile (messageRequestId null) hoặc report gắn
// với một message request cụ thể (unique để không report trùng 1 request).
model UserReport {
  id               String       @id @default(uuid())
  reporterId       String
  reportedId       String
  reason           ReportReason
  details          String?
  messageRequestId String?      @unique
  createdAt        DateTime     @default(now())

  reporter       User            @relation("UserReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reported       User            @relation("UserReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)
  messageRequest MessageRequest? @relation(fields: [messageRequestId], references: [id], onDelete: SetNull)

  @@index([reportedId])
  @@index([reporterId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  senderId  String?
  pinId     String?
  type      String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  sender User? @relation("UserSentNotifications", fields: [senderId], references: [id], onDelete: SetNull)
  pin    Pin?  @relation(fields: [pinId], references: [id], onDelete: SetNull)
}

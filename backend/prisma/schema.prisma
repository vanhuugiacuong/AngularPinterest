// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Bảng User đồng bộ với id từ auth.users của Supabase
model User {
  id           String    @id // Trùng với ID UUID do Supabase Auth cấp
  username     String    @unique
  email        String    @unique
  avatarUrl    String?
  bio          String?
  createdAt    DateTime  @default(now())
  plan         MembershipPlan @default(FREE)
  planStartedAt DateTime?
  aiUsages     AiUsage[]
  purchases    ImagePurchase[] @relation("BuyerPurchases")
  sales        ImagePurchase[] @relation("SellerSales")
  
  pins         Pin[]
  boards       Board[]
  likes        Like[]
  comments     Comment[]
  
  followers    Follow[]  @relation("UserFollowers")
  following    Follow[]  @relation("UserFollowing")
  messageRequestsSent     MessageRequest[] @relation("MessageRequestsSent")
  messageRequestsReceived MessageRequest[] @relation("MessageRequestsReceived")
  conversationsAsUserOne  Conversation[]   @relation("ConversationsAsUserOne")
  conversationsAsUserTwo  Conversation[]   @relation("ConversationsAsUserTwo")
  messages                Message[]
  blocksMade              UserBlock[]      @relation("UserBlocksMade")
  blocksReceived          UserBlock[]      @relation("UserBlocksReceived")
  reportsMade             UserReport[]     @relation("UserReportsMade")
  reportsReceived         UserReport[]     @relation("UserReportsReceived")

  notifications     Notification[] @relation("UserNotifications")
  sentNotifications Notification[] @relation("UserSentNotifications")
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model Pin {
  id              String      @id @default(uuid())
  title           String
  description     String?
  imageUrl        String      // CDN URL từ Supabase Storage Bucket ("pins")
  sourceUrl       String?
  userId          String
  createdAt       DateTime    @default(now())
  price           Decimal?    @db.Decimal(12, 2)
  isForSale       Boolean     @default(false)
  purchases       ImagePurchase[]

  isAiGenerated   Boolean     @default(false)
  promptUsed      String?
  negativePrompt  String?
  generationModel String?
  category        String      @default("other")
  embedding       Unsupported("vector(512)")?

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardPins       BoardPin[]
  likes           Like[]
  comments        Comment[]
  notifications   Notification[]
}

enum MembershipPlan {
  FREE
  PLUS
  PRO
}

model AiUsage {
  id        String   @id @default(uuid())
  userId    String
  usageDate DateTime @db.Date
  count     Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, usageDate])
}

model ImagePurchase {
  id        String   @id @default(uuid())
  pinId     String
  buyerId   String
  sellerId  String
  amount    Decimal  @db.Decimal(12, 2)
  status    String   @default("PAID")
  createdAt DateTime @default(now())
  pin       Pin      @relation(fields: [pinId], references: [id], onDelete: Cascade)
  buyer     User     @relation("BuyerPurchases", fields: [buyerId], references: [id], onDelete: Cascade)
  seller    User     @relation("SellerSales", fields: [sellerId], references: [id], onDelete: Cascade)
  @@unique([pinId, buyerId])
}

model Board {
  id          String      @id @default(uuid())
  name        String
  description String?
  isSecret    Boolean     @default(false)
  userId      String
  createdAt   DateTime    @default(now())

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardPins       BoardPin[]
}

model BoardPin {
  boardId   String
  pinId     String
  addedAt   DateTime @default(now())

  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  pin       Pin      @relation(fields: [pinId], references: [id], onDelete: Cascade)

  @@id([boardId, pinId])
}

model Like {
  userId    String
  pinId     String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pin       Pin      @relation(fields: [pinId], references: [id], onDelete: Cascade)

  @@id([userId, pinId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  userId    String
  pinId     String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pin       Pin      @relation(fields: [pinId], references: [id], onDelete: Cascade)
}

enum MessageRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  REPORTED
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  IMPERSONATION
  INAPPROPRIATE_CONTENT
  OTHER
}

// Một lời mời nhắn tin giữa hai người dùng chưa follow lẫn nhau.
// Ràng buộc unique theo đúng chiều gửi để chặn gửi trùng (nghiệp vụ +
// application layer chặn luôn cả chiều ngược lại trước khi tạo).
model MessageRequest {
  id          String               @id @default(uuid())
  senderId    String
  receiverId  String
  status      MessageRequestStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  respondedAt DateTime?

  sender   User        @relation("MessageRequestsSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User        @relation("MessageRequestsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  report   UserReport?

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

// Cuộc trò chuyện 1-1. participantKey chuẩn hóa cặp userId (sắp xếp rồi nối
// lại) để unique constraint ngăn tạo trùng conversation cho cùng một cặp,
// kể cả khi hai yêu cầu tạo chạy gần như đồng thời.
model Conversation {
  id             String    @id @default(uuid())
  participantKey String    @unique
  userOneId      String
  userTwoId      String
  createdAt      DateTime  @default(now())
  lastMessageAt  DateTime?

  userOne  User      @relation("ConversationsAsUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo  User      @relation("ConversationsAsUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userOneId])
  @@index([userTwoId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String    @db.VarChar(4000)
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("UserBlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// Report độc lập từ trang profile (messageRequestId null) hoặc report gắn
// với một message request cụ thể (unique để không report trùng 1 request).
model UserReport {
  id               String       @id @default(uuid())
  reporterId       String
  reportedId       String
  reason           ReportReason
  details          String?
  messageRequestId String?      @unique
  createdAt        DateTime     @default(now())

  reporter       User            @relation("UserReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reported       User            @relation("UserReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)
  messageRequest MessageRequest? @relation(fields: [messageRequestId], references: [id], onDelete: SetNull)

  @@index([reportedId])
  @@index([reporterId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  senderId  String?
  pinId     String?
  type      String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  sender    User?    @relation("UserSentNotifications", fields: [senderId], references: [id], onDelete: SetNull)
  pin       Pin?     @relation(fields: [pinId], references: [id], onDelete: SetNull)
}

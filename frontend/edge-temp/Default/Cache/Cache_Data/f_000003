        @if (currentState().error && currentState().items.length > 0) {
          <div class="inline-error" role="alert">
            <span>{{ currentState().error }}</span>
            <button type="button" (click)="retryActiveTab()">Th\u1EED l\u1EA1i</button>
          </div>
        }

        @if (currentState().hasMore || currentState().loadingMore) {
          <div class="load-more-row">
            <button
              type="button"
              class="secondary-action"
              [disabled]="currentState().loadingMore"
              (click)="loadMore()"
            >

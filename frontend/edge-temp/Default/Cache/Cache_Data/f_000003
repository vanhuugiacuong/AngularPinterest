                <span class="material-symbols-outlined">lock</span>
                Ch\u1EC9 m\xECnh b\u1EA1n
              </span>
            </div>

            @if (favoritesState().loading) {
              <ng-container *ngTemplateOutlet="pinLoading"></ng-container>
            } @else if (favoritesState().error && favoritesState().items.length === 0) {
              <ng-container
                *ngTemplateOutlet="tabError; context: { $implicit: favoritesState().error }"
              ></ng-container>
            } @else if (favoritesState().loaded && favoritesState().items.length === 0) {
              <div class="profile-state">
                <span class="material-symbols-outlined state-icon">favorite_border</span>
                <h3>B\u1EA1n ch\u01B0a th\xEDch b\xE0i \u0111\u0103ng n\xE0o</h3>
                <p>Nh\u1EEFng b\xE0i \u0111\u0103ng b\u1EA1n \u0111\xE3 th\xEDch s\u1EBD \u0111\u01B0\u1EE3c gi\u1EEF ri\xEAng t\u1EA1i \u0111\xE2y.</p>
                <button type="button" class="primary-action" (click)="navigateTo('/feed')">
                  Kh\xE1m ph\xE1 b\xE0i \u0111\u0103ng
                </button>
              </div>
            } @else {
              <div class="pin-grid">
                @for (pin of favoritesState().items; track pin.id) {
                  <article class="pin-card">
                    <button
                      type="button"
                      class="pin-media"
                      (click)="navigateToPin(pin.id)"
                      [attr.aria-label]="'M\u1EDF b\xE0i \u0111\u0103ng ' + pin.title"
                    >
                      <img [src]="pin.imageUrl" [alt]="pin.title" loading="lazy" />
                      @if (pin.isAiGenerated) {
                        <span class="ai-badge">
                          <span class="material-symbols-outlined">auto_awesome</span> AI
                        </span>
                      }
                      <span class="pin-open-hint">Xem b\xE0i \u0111\u0103ng</span>
                    </button>
                    <div class="pin-meta">
                      <div class="pin-copy">

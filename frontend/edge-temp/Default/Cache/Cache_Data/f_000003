        <p id="delete-pin-description">B\xE0i \u0111\u0103ng s\u1EBD b\u1ECB x\xF3a kh\u1ECFi NovaFrame v\xE0 kh\xF4ng th\u1EC3 kh\xF4i ph\u1EE5c.</p>
        @if (deleteError()) {
          <p class="form-error" role="alert">{{ deleteError() }}</p>

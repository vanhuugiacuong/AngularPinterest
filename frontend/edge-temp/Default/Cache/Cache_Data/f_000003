                <span class="button-spinner" aria-hidden="true"></span>
                \u0110ang t\u1EA1o
              } @else {
                T\u1EA1o b\u1ED9 s\u01B0u t\u1EADp
              }
            </button>
          </div>
        </form>
      </section>
    </div>
  }

  @if (deleteTarget(); as pin) {

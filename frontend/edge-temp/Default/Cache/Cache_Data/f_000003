                        <span>@{{ pin.user.username }}</span>
                      </div>
                      <button
                        type="button"
                        class="icon-action liked"
                        (click)="removeFavorite(pin, $event)"
                        aria-label="B\u1ECF th\xEDch b\xE0i \u0111\u0103ng n\xE0y"
                        title="B\u1ECF th\xEDch"
                      >
                        <span class="material-symbols-outlined">favorite</span>
                        <span>{{ pin._count.likes }}</span>
                      </button>
                    </div>
                  </article>
                }
              </div>
            }
          </div>
